# PostgreSQL Connection Parameters
PGHOST=localhost
PGPORT=5432
PGDATABASE=technical_kb
PGUSER=postgres
PGPASSWORD=postgres

# Embedding Engine Settings
# Options: local-semantic-384 (zero-dependency fallback), fastembed, sentence-transformers, BAAI/bge-small-en-v1.5
EMBEDDING_MODEL=local-semantic-384
EMBEDDING_DIM=384

# MCP Server Settings
# Comma-separated list of keywords or folder names recognized for analysis workspaces
KB_RECOGNIZED_FOLDERS=hypervisor,kernel,driver,analysis,re,ida,ghidra,x64dbg,symbols,devirt,knowledge_base
